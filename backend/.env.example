# Application Metadata
NEXT_PUBLIC_APP_NAME="SolarGrid"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_TITLE="SolarGrid | Digital Solar Infrastructure. Community Powered."

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Payment Gateway Webhook (HMAC-SHA256 over raw body; header: x-solar-signature)
PAYMENT_WEBHOOK_SECRET="generate-with-openssl-rand-hex-32-min-16-chars"

# Business Parameters
DEFAULT_STARTING_POINTS=100
WORKING_DAYS_PER_CYCLE=43
DEFAULT_CYCLE_CALENDAR_DAYS=60
# Compliant referral commission rates (max 2 levels, JSONB in business_rules.REFERRAL_COMMISSION)
REFERRAL_COMMISSION_L1_PERCENT=10
REFERRAL_COMMISSION_L2_PERCENT=5
