# Application Metadata
PORT=5001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@your-neon-host-pooler.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@your-neon-host.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="your-minimum-32-character-cryptographic-jwt-secret"

# Payment Gateway Webhook (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET="generate-with-openssl-rand-hex-32-min-16-chars"

# Business Parameters
DEFAULT_STARTING_POINTS=100
WORKING_DAYS_PER_CYCLE=43
DEFAULT_CYCLE_CALENDAR_DAYS=60
